# Cognito Hosted UI Domain (e.g., my-domain.auth.us-east-1.amazoncognito.com)
VITE_COGNITO_DOMAIN=placeholder.auth.us-east-1.amazoncognito.com

# Cognito Portal App Client ID
VITE_COGNITO_CLIENT_ID=placeholder-client-id

# OAuth Redirect URI (must match Cognito app client callback URLs)
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/callback

# Provisioning API Base URL
VITE_API_URL=http://localhost:5000
