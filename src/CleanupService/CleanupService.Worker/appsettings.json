{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "CleanupService": "Information"
    }
  },
  "DynamoDb": {
    "TableName": "workspace-lookup"
  },
  "CleanupPolicy": {
    "MaxAgeHours": 8,
    "ProvisioningTimeoutMinutes": 30,
    "DeletingTimeoutMinutes": 60,
    "FailedCleanupTimeoutMinutes": 60
  }
}
